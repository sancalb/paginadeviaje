# This file belongs to discover-mexico. Never load the parent's .env.
SITE_URL=https://discover.deviaje.mx
APP_ORIGIN=http://localhost:4191
INQUIRIES_MODE=development
# E.164 business number. Development returns 503 until configured.
WHATSAPP_NUMBER=528135294738

# Read-only shared original files, resolved from the discover-mexico working directory.
GOOGLE_REVIEWS_CACHE_PATH=../storage/google-reviews-cache.json
GOOGLE_REVIEWS_CONFIG_PATH=../config/google-reviews-branches.json
# Optional trusted cached service endpoint, no query string. Never a SearchAPI URL.
GOOGLE_REVIEWS_SERVICE_URL=
# Optional English sidecar, matched by review ID and original-text fingerprint.
GOOGLE_REVIEW_TRANSLATIONS_PATH=./data/review-translations.json
# Explicit publication permission, e.g. [{"id":"example","displayName":"Example","active":true,"bilingual":true}]
EXPERTS_ALLOWLIST_JSON=[]
PROMOTIONS_PATH=
# Initial published packages exclude international flights unless expressly authorized.
# Each flight needs flightScope: domestic, or international with this exact true opt-in.
# Missing/unknown scope is never authorized; legacy priceUsd still requires flight + hotel.
ALLOW_INTERNATIONAL_FLIGHTS=false

# Live requires an independently deployed durable gateway implementing the documented protocol.
INQUIRIES_STORAGE_URL=
INQUIRIES_STORAGE_TOKEN=
RATE_LIMIT_HMAC_KEY=
# Set only if the ingress strips/overwrites this header. Empty means a shared rate bucket.
TRUSTED_CLIENT_IP_HEADER=
# Both language rules required; configure real IDs, never sample or inferred responsible users.
# Shape: {"en":{"tags":["inbound"],"responsibleUserId":1,"pipelineId":1,"statusId":1,"task":{"typeId":1,"dueInMinutes":60}},"es":{...}}
KOMMO_RULES_JSON=
